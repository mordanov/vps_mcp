VPS_HOST=
VPS_PORT=22
VPS_USER=deploy
VPS_SSH_KEY=~/.ssh/vps_mcp
VPS_KNOWN_HOSTS=~/.ssh/known_hosts

# Optional. Required for Docker Compose tools.
DOCKER_COMPOSE_DIR=/opt/your-project

# Optional. Default repo for GitHub Actions tools (owner/repo format).
# Can be overridden per-call; requires `gh` CLI installed and authenticated on the VPS.
GITHUB_REPO=

# Maximum output returned by one SSH command, in characters.
MAX_OUTPUT_CHARS=20000
